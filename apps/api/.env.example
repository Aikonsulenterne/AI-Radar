# Kopiér til .env — commit aldrig rigtige værdier.
ENVIRONMENT=local

# PostgreSQL (Supabase lokal: postgresql+psycopg://postgres:postgres@localhost:54322/postgres)
# Uden værdi bruges en lokal SQLite-fil (kun til hurtig lokal udvikling).
DATABASE_URL=

# CORS: kommasepareret liste over godkendte origins.
CORS_ORIGINS=http://localhost:3000

# Supabase Auth: ES256/RS256-tokens (moderne signing keys) valideres
# automatisk via SUPABASE_URL's JWKS-endpoint. SUPABASE_JWT_SECRET er kun
# nødvendig for legacy HS256-projekter. Tom secret i ENVIRONMENT=local
# aktiverer dev-bypass (alle kald som Admin) — aldrig i staging/production.
SUPABASE_JWT_SECRET=

# Storage: local (udvikling) eller supabase (private buckets).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.storage
SUPABASE_URL=
# Service-role key bruges KUN server-side og logges aldrig:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Grænser for upload og fetch.
MAX_UPLOAD_BYTES=20000000
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=5000000

# AI-provider (Technical Master §10). AI_PROVIDER vælger adapteren:
#   openai_compat — ethvert OpenAI-kompatibelt endpoint; kræver AI_PROVIDER_BASE_URL
#   anthropic     — Claude via Anthropics SDK; AI_PROVIDER_BASE_URL bruges ikke
AI_PROVIDER=openai_compat
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL_ID=
